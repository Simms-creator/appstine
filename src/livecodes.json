  "markup": {
    "language": "html",
    "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Appstine Tech</title>\n\n  <style>\n    * { box-sizing: border-box; margin: 0; padding: 0; font-family: Arial, sans-serif; }\n\n    body {\n      background: #f5f5f5;\n      color: #333;\n      transition: 0.3s;\n    }\n\n    body.dark {\n      background: #121212;\n      color: #eee;\n    }\n\n    header {\n      background: linear-gradient(90deg, #6a11cb, #2575fc);\n      color: white;\n      padding: 60px 20px;\n      text-align: center;\n    }\n\n    section {\n      padding: 50px 20px;\n      max-width: 900px;\n      margin: auto;\n    }\n\n    h2 {\n      text-align: center;\n      margin-bottom: 20px;\n      color: #2575fc;\n    }\n\n    body.dark h2 {\n      color: #9ecbff;\n    }\n\n    footer {\n      text-align: center;\n      padding: 20px;\n      background: #333;\n      color: #fff;\n    }\n\n    .credit {\n      text-align: center;\n      margin-top: 10px;\n    }\n\n    .toggle {\n      position: fixed;\n      top: 15px;\n      right: 15px;\n      background: #2575fc;\n      color: white;\n      border: none;\n      padding: 8px 12px;\n      border-radius: 8px;\n      cursor: pointer;\n    }\n\n    .video-preview {\n      position: relative;\n      cursor: pointer;\n    }\n\n    .video-preview img {\n      width: 100%;\n      border-radius: 12px;\n    }\n\n    .play-btn {\n      position: absolute;\n      top: 50%;\n      left: 50%;\n      transform: translate(-50%, -50%);\n      font-size: 60px;\n      color: white;\n      background: rgba(0,0,0,0.6);\n      border-radius: 50%;\n      padding: 10px 20px;\n    }\n\n    .modal {\n      display: none;\n      position: fixed;\n      z-index: 1000;\n      left: 0;\n      top: 0;\n      width: 100%;\n      height: 100%;\n      background: rgba(0,0,0,0.9);\n      justify-content: center;\n      align-items: center;\n      flex-direction: column;\n    }\n\n    .modal-content {\n      width: 90%;\n      max-width: 800px;\n      position: relative;\n    }\n\n    iframe {\n      width: 100%;\n      height: 450px;\n      border-radius: 12px;\n    }\n\n    .close {\n      position: absolute;\n      top: -40px;\n      right: 0;\n      font-size: 30px;\n      color: white;\n      cursor: pointer;\n    }\n\n    .unmute-btn {\n      margin-top: 15px;\n      padding: 10px 20px;\n      background: #ff3c6e;\n      color: white;\n      border: none;\n      border-radius: 8px;\n      cursor: pointer;\n      font-weight: bold;\n    }\n  </style>\n</head>\n\n<body>\n\n  <button class=\"toggle\" onclick=\"toggleDark()\">🌙 Dark Mode</button>\n\n  <header>\n    <h1>Appstine Tech</h1>\n    <p>Innovating Technology for Everyday Life</p>\n  </header>\n\n  <section>\n    <h2>About Us</h2>\n    <p>Appstine Tech is dedicated to making life easier through modern technology.</p>\n  </section>\n\n  <!-- VIDEO -->\n  <section>\n    <h2>Watch Our Feature</h2>\n    <div class=\"video-preview\" onclick=\"openVideo()\">\n      <img src=\"https://img.youtube.com/vi/03gy_O5w_8U/maxresdefault.jpg\">\n      <div class=\"play-btn\">▶</div>\n    </div>\n  </section>\n\n  <!-- MODAL -->\n  <div class=\"modal\" id=\"videoModal\">\n    <div class=\"modal-content\">\n      <span class=\"close\" onclick=\"closeVideo()\">✖</span>\n      <iframe id=\"videoFrame\"\n        src=\"\"\n        allow=\"autoplay; encrypted-media\"\n        allowfullscreen>\n      </iframe>\n    </div>\n\n    <button class=\"unmute-btn\" onclick=\"unmuteVideo()\">🔊 Unmute</button>\n  </div>\n\n  <footer>\n    <p>© 2026 Appstine Tech. All rights reserved.</p>\n  </footer>\n\n  <div class=\"credit\">\n    Built by Innovatex Software Engineering Co. Ltd.\n  </div>\n\n  <script>\n    function openVideo() {\n      document.getElementById(\"videoModal\").style.display = \"flex\";\n      document.getElementById(\"videoFrame\").src =\n        \"https://www.youtube.com/embed/03gy_O5w_8U?autoplay=1&mute=1\";\n    }\n\n    function closeVideo() {\n      document.getElementById(\"videoModal\").style.display = \"none\";\n      document.getElementById(\"videoFrame\").src = \"\";\n    }\n\n    function unmuteVideo() {\n      document.getElementById(\"videoFrame\").src =\n        \"https://www.youtube.com/embed/03gy_O5w_8U?autoplay=1\";\n    }\n\n    function toggleDark() {\n      document.body.classList.toggle(\"dark\");\n    }\n  </script>\n\n</body>\n</html>"
  },
