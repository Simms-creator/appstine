  "activeEditor": "markup",
  "markup": {
    "language": "html",
    "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Appstine Tech</title>\n\n  <style>\n    * { box-sizing: border-box; margin: 0; padding: 0; font-family: Arial, sans-serif; }\n    body { background: #f5f5f5; color: #333; transition: 0.3s; }\n    body.dark { background: #121212; color: #eee; }\n\n    header { background: linear-gradient(90deg, #6a11cb, #2575fc); color: white; padding: 60px 20px; text-align: center; }\n    section { padding: 50px 20px; max-width: 900px; margin: auto; }\n    h2 { text-align: center; margin-bottom: 20px; color: #2575fc; }\n    body.dark h2 { color: #9ecbff; }\n    footer { text-align: center; padding: 20px; background: #333; color: #fff; }\n    .credit { text-align: center; margin-top: 10px; }\n\n    .toggle { position: fixed; top: 15px; right: 15px; background: #2575fc; color: white; border: none; padding: 8px 12px; border-radius: 8px; cursor: pointer; }\n\n    .video-preview { position: relative; cursor: pointer; margin-bottom: 30px; }\n    .video-preview img { width: 100%; border-radius: 12px; }\n    .play-btn { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-size: 60px; color: white; background: rgba(0,0,0,0.6); border-radius: 50%; padding: 10px 20px; }\n\n    .modal { display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.9); justify-content: center; align-items: center; flex-direction: column; animation: fadeIn 0.3s; }\n    @keyframes fadeIn { from {opacity:0;} to {opacity:1;} }\n\n    .modal-content { width: 90%; max-width: 800px; position: relative; }\n    iframe { width: 100%; height: 450px; border-radius: 12px; }\n    .close { position: absolute; top: -40px; right: 0; font-size: 30px; color: white; cursor: pointer; }\n    .unmute-btn, .download-btn { margin-top: 15px; padding: 10px 20px; background: #ff3c6e; color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: bold; margin-right: 10px; }\n    .download-btn { background: #2575fc; text-decoration: none; display: inline-block; }\n  </style>\n</head>\n\n<body>\n\n<button class=\"toggle\" onclick=\"toggleDark()\" id=\"darkBtn\">🌙 Dark Mode</button>\n\n<header>\n  <h1>Appstine Tech</h1>\n  <p>Innovating Technology for Everyday Life</p>\n</header>\n\n<section>\n  <h2>Our Videos</h2>\n\n  <!-- Video 1 -->\n  <div class=\"video-preview\" onclick=\"openVideo('video1')\">\n    <img src=\"https://img.youtube.com/vi/03gy_O5w_8U/maxresdefault.jpg\">\n    <div class=\"play-btn\">▶</div>\n    <a class=\"download-btn\" href=\"https://www.youtube.com/watch?v=03gy_O5w_8U\" target=\"_blank\">⬇ Download</a>\n  </div>\n\n  <!-- Video 2 -->\n  <div class=\"video-preview\" onclick=\"openVideo('video2')\">\n    <img src=\"https://img.youtube.com/vi/Ob4mAMCvNIg/maxresdefault.jpg\">\n    <div class=\"play-btn\">▶</div>\n    <a class=\"download-btn\" href=\"https://www.youtube.com/watch?v=Ob4mAMCvNIg\" target=\"_blank\">⬇ Download</a>\n  </div>\n</section>\n\n<!-- Modal -->\n<div class=\"modal\" id=\"videoModal\">\n  <div class=\"modal-content\">\n    <span class=\"close\" onclick=\"closeVideo()\">✖</span>\n    <iframe id=\"videoFrame\" src=\"\" allow=\"autoplay; encrypted-media\" allowfullscreen></iframe>\n  </div>\n  <button class=\"unmute-btn\" onclick=\"unmuteVideo()\">🔊 Unmute</button>\n</div>\n\n<footer>\n  <p>© 2026 Appstine Tech. All rights reserved.</p>\n</footer>\n\n<div class=\"credit\">\n  Built by Innovatex Software Engineering Co. Ltd.\n</div>\n\n<script>\n  let currentVideo = '';\n\n  function openVideo(video) {\n    document.getElementById(\"videoModal\").style.display = \"flex\";\n    currentVideo = video;\n\n    if(video === 'video1'){\n      document.getElementById(\"videoFrame\").src = \"https://www.youtube.com/embed/03gy_O5w_8U?autoplay=1&mute=1\";\n    } else if(video === 'video2'){\n      document.getElementById(\"videoFrame\").src = \"https://www.youtube.com/embed/Ob4mAMCvNIg?autoplay=1&mute=1\";\n    }\n  }\n\n  function closeVideo() {\n    document.getElementById(\"videoModal\").style.display = \"none\";\n    document.getElementById(\"videoFrame\").src = \"\";\n  }\n\n  function unmuteVideo() {\n    if(currentVideo === 'video1'){\n      document.getElementById(\"videoFrame\").src = \"https://www.youtube.com/embed/03gy_O5w_8U?autoplay=1\";\n    } else if(currentVideo === 'video2'){\n      document.getElementById(\"videoFrame\").src = \"https://www.youtube.com/embed/Ob4mAMCvNIg?autoplay=1\";\n    }\n  }\n\n  function toggleDark() {\n    document.body.classList.toggle(\"dark\");\n    let btn = document.getElementById(\"darkBtn\");\n    btn.innerText = document.body.classList.contains(\"dark\") ? \"☀ Light Mode\" : \"🌙 Dark Mode\";\n  }\n</script>\n\n</body>\n</html>"
  },
